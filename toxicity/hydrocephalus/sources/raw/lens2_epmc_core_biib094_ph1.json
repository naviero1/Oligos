":"Hospital Universitari General de Catalunya, Barcelona, Spain."}]}},{"fullName":"Marti MJ","firstName":"Maria J","lastName":"Marti","initials":"MJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Unidad de Parkinson y Trastornos del Movimiento, Hospital Clínic de Barcelona, IDIBAPS, CIBER-ISCIII, Barcelona, Spain."}]}},{"fullName":"Zhao HT","firstName":"Hien T","lastName":"Zhao","initials":"HT","authorId":{"type":"ORCID","value":"0009-0000-0904-8201"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ionis, Carlsbad, CA, USA."}]}},{"fullName":"Kordasiewicz HB","firstName":"Holly B","lastName":"Kordasiewicz","initials":"HB","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ionis, Carlsbad, CA, USA."}]}},{"fullName":"Lane R","firstName":"Roger","lastName":"Lane","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ionis, Carlsbad, CA, USA."}]}},{"fullName":"Hirst WD","firstName":"Warren D","lastName":"Hirst","initials":"WD","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Biogen Inc, Cambridge, MA, USA."},{"affiliation":"DaCapo Brainscience, Cambridge, MA, USA."}]}},{"fullName":"Fradette S","firstName":"Stephanie","lastName":"Fradette","initials":"S","authorId":{"type":"ORCID","value":"0009-0005-1807-1602"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Biogen Inc, Cambridge, MA, USA."}]}},{"fullName":"Graham DL","firstName":"Danielle L","lastName":"Graham","initials":"DL","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Biogen Inc, Cambridge, MA, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5325-1944"},{"type":"ORCID","value":"0000-0001-9258-1735"},{"type":"ORCID","value":"0000-0002-3493-5491"},{"type":"ORCID","value":"0000-0002-5473-3774"},{"type":"ORCID","value":"0000-0002-6468-4734"},{"type":"ORCID","value":"0000-0003-1656-302X"},{"type":"ORCID","value":"0000-0003-2092-9848"},{"type":"ORCID","value":"0000-0003-2639-6982"},{"type":"ORCID","value":"0009-0000-0904-8201"},{"type":"ORCID","value":"0009-0005-1807-1602"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"4","volume":"32","journalIssueId":4183605,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Nature medicine","medlineAbbreviation":"Nat Med","isoabbreviation":"Nat Med","nlmid":"9502015","essn":"1546-170X","issn":"1078-8956"}},"pubYear":"2026","pageInfo":"1421-1431","abstractText":"LRRK2 (encoding leucine-rich repeat kinase 2) variants are the most common genetic cause of Parkinson's disease (PD). Lowering LRRK2 levels and/or inhibiting LRRK2 activity may modify PD-associated neuropathology. BIIB094 (ION859), an antisense oligonucleotide, targets LRRK2 mRNA for degradation. REASON was a first-in-human randomized phase 1 study investigating the safety, tolerability, pharmacokinetics and pharmacodynamics of intrathecal BIIB094 in patients with PD. In part A, 40 participants received single doses of BIIB094 10-150 mg or placebo. In part B, 42 participants, stratified by LRRK2 variant status, received four doses of BIIB094 40-120 mg or placebo every 4 weeks. Adverse events were reported by 64.5% (20/31) of participants in part A and by 84.8% (28/33) of participants in part B. The events were mainly mild to moderate and not dose limiting. No serious adverse events related to BIIB094 were reported in either part A or B. Systemic BIIB094 exposure increased with dose. Cerebrospinal fluid (CSF) LRRK2 and phosphorylated Rab10 levels were lowered by up to 59% and up to 50%, respectively, irrespective of LRRK2 variant status. Concomitant reductions in CSF lysosomal protein levels suggested a potential mechanism whereby LRRK2 therapeutics may impact underlying PD pathophysiology. ClinicalTrials.gov identifier, NCT03976349 ; EudraCT number, 2018-002995-42.","affiliation":"Biogen Inc, Cambridge, MA, USA. omar.mabrouk@biogen.com.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Clinical Trial, Phase I","Randomized Controlled Trial","Journal Article"]},"grantsList":{"grant":[{"agency":"Biogen","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Parkinson Disease","meshQualifierList":{"meshQualifier":[{"abbreviation":"DT","qualifierName":"drug therapy","majorTopic_YN":"N"},{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"PA","qualifierName":"pathology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Oligonucleotides, Antisense","meshQualifierList":{"meshQualifier":[{"abbreviation":"AD","qualifierName":"administration & dosage","majorTopic_YN":"N"},{"abbreviation":"AE","qualifierName":"adverse effects","majorTopic_YN":"N"},{"abbreviation":"PK","qualifierName":"pharmacokinetics","majorTopic_YN":"N"},{"abbreviation":"TU","qualifierName":"therapeutic use","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Aged"},{"majorTopic_YN":"N","descriptorName":"Middle Aged"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"Y","descriptorName":"Leucine-Rich Repeat Serine-Threonine Protein Kinase-2","meshQualifierList":{"meshQualifier":[{"abbreviation":"AI","qualifierName":"antagonists & inhibitors","majorTopic_YN":"N"},{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"}]}}]},"chemicalList":{"chemical":[{"name":"Oligonucleotides, Antisense","registryNumber":"0"},{"name":"LRRK2 protein, human","registryNumber":"EC 2.7.11.1"},{"name":"Leucine-Rich Repeat Serine-Threonine Protein Kinase-2","registryNumber":"EC 2.7.11.1"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode"